global
    log /dev/log local0
    log /dev/log local1 notice
    user haproxy
    group haproxy
    daemon
    maxconn 4096

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend tls_sni_router
    bind *:443
    tcp-request inspect-delay 5s
    tcp-request content accept if { req.ssl_hello_type 1 }

    use_backend wecom_bridge_tls if { req.ssl_sni -i wecom-kf.example.com }
    default_backend existing_tls_service

backend wecom_bridge_tls
    server nginx_wecom 127.0.0.1:8443 check

backend existing_tls_service
    # Move the service that previously owned :443 to this loopback port first.
    server existing 127.0.0.1:9443 check
