[Unit]
Description=WeCom Hermes Agent Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wecom-bridge
Group=wecom-bridge
WorkingDirectory=/opt/wecom-hermes-agent-bridge
EnvironmentFile=/etc/wecom-hermes-agent-bridge/bridge.env
Environment=BRIDGE_DB_PATH=/var/lib/wecom-hermes-agent-bridge/bridge.db
ExecStart=/opt/wecom-hermes-agent-bridge/.venv/bin/uvicorn wecom_hermes_bridge.main:app --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wecom-hermes-agent-bridge
UMask=0077

[Install]
WantedBy=multi-user.target
