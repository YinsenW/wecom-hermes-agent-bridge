server {
    listen 443 ssl http2;
    server_name wecom-kf.example.com;

    ssl_certificate /etc/letsencrypt/live/wecom-kf.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wecom-kf.example.com/privkey.pem;

    client_max_body_size 1m;

    location = /callbacks/wecom/kf {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location / {
        return 404;
    }
}
