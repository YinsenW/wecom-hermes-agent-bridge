server {
    listen 80;
    server_name wecom-kf.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location ~ ^/WW_verify_[A-Za-z0-9]+\.txt$ {
        root /var/www/wecom-domain-verification;
        try_files $uri =404;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name wecom-kf.example.com;

    ssl_certificate /etc/letsencrypt/live/wecom-kf.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wecom-kf.example.com/privkey.pem;

    client_max_body_size 1m;

    location ~ ^/WW_verify_[A-Za-z0-9]+\.txt$ {
        root /var/www/wecom-domain-verification;
        try_files $uri =404;
        default_type text/plain;
    }

    location = /callbacks/wecom/kf {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    location / {
        return 404;
    }
}
