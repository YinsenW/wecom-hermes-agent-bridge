# Runtime
BRIDGE_ENV=production
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080
BRIDGE_DB_PATH=data/bridge.db
BRIDGE_DRY_RUN=true

# WeCom Customer Service
WECOM_CORP_ID=ww_your_corp_id
WECOM_APP_SECRET=replace_with_app_secret
WECOM_CALLBACK_TOKEN=replace_with_random_callback_token
WECOM_CALLBACK_AES_KEY=replace_with_43_character_encoding_aes_key
WECOM_ALLOWED_KF_IDS=wk_your_customer_service_account_id
WECOM_API_BASE=https://qyapi.weixin.qq.com

# Hermes Sessions API
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=replace_with_a_strong_random_api_key
HERMES_TIMEOUT_SECONDS=25

# Optional Markdown knowledge base
KNOWLEDGE_BASE_PATH=examples/knowledge-base.example.md
KNOWLEDGE_TRIGGER_TERMS=产品,价格,售后,退款,发票
KNOWLEDGE_TOP_K=4
KNOWLEDGE_MAX_CHARS=6000
